---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews');
  return interviews.map(interview => ({
    params: { slug: interview.id },
    props: { interview },
  }));
}

const { interview } = Astro.props;
const { Content } = await render(interview);

const imagePath = `/headshots/${interview.data.interviewee}.png`;
---

<Layout 
  title={`${interview.data.title} | Ride The Tiger`}
  description={interview.data.excerpt}
  image={imagePath}
  type="article"
  keywords={interview.data.tags}
  publishedTime={interview.data.date}
>
  <article class="bg-white border-b-8 border-tiger-500">
    <header class="container mx-auto px-6 max-w-4xl py-20 lg:py-32">
      <div class="mb-8 flex flex-wrap gap-4 items-center">
        {interview.data.tags.map(tag => (
          <span class="bg-[var(--color-charcoal)] text-[var(--color-offwhite)] text-xs font-bold uppercase tracking-widest px-3 py-1">
            {tag}
          </span>
        ))}
      </div>
      <div class="flex flex-col md:flex-row gap-8 items-start mb-8">
        <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.9] flex-1">
          {interview.data.title}
        </h1>
        <div class="w-32 h-32 md:w-48 md:h-48 flex-shrink-0 bg-gray-200 border-4 border-tiger-500 overflow-hidden shadow-xl">
          <img src={imagePath} alt={`Headshot of ${interview.data.interviewee}`} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" />
        </div>
      </div>
      
      <blockquote class="pull-quote text-2xl md:text-4xl max-w-3xl mb-12">
        "{interview.data.quote}"
      </blockquote>

      <div class="flex flex-wrap gap-x-12 gap-y-6 pt-8 border-t-2 border-[var(--color-charcoal)] mt-12">
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Interviewee</h4>
          <p class="text-lg font-bold text-[var(--color-charcoal)]">{interview.data.interviewee}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Role</h4>
          <p class="text-lg text-[var(--color-charcoal)]">{interview.data.role}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Company</h4>
          <p class="text-lg text-[var(--color-charcoal)]">{interview.data.company}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Read Time</h4>
          <p class="text-lg text-[var(--color-charcoal)]">{interview.data.readTime}</p>
        </div>
      </div>
    </header>

    <div class="bg-[var(--color-offwhite)] py-20 border-t border-gray-200">
      <div class="container mx-auto px-6 max-w-3xl">
        <div class="prose prose-lg prose-neutral max-w-none 
          prose-h3:text-3xl prose-h3:font-bold prose-h3:uppercase prose-h3:tracking-tight prose-h3:mt-16 prose-h3:mb-8
          prose-p:leading-relaxed prose-p:mb-8
          prose-strong:text-[var(--color-charcoal)] prose-strong:font-black">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
