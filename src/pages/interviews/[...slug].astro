---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  renderMarkdownWithInlineImages,
  resolveInterviewImage,
} from '../../utils/articleRenderer';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews');
  return interviews.map(interview => ({
    params: { slug: interview.id },
    props: { interview },
  }));
}

const { interview } = Astro.props;
const imagePath = resolveInterviewImage(interview.data);
const initialAudioUrl = interview.data.audioUrl || `/audio/${interview.id}.mp3`;
const renderedArticleHtml = renderMarkdownWithInlineImages(
  interview.body || '',
  interview.data.inlineImages || []
);

const allInterviews = await getCollection('interviews');
const relatedInterviews = allInterviews
  .filter(i => i.id !== interview.id && i.data.tags.some(t => interview.data.tags.includes(t)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

let rawDesc = interview.data.excerpt || interview.data.quote || "";
let seoDescription = rawDesc.length > 155 ? rawDesc.substring(0, 152) + '...' : rawDesc;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": interview.data.title,
      "image": new URL(imagePath, Astro.site || Astro.url.origin).toString(),
      "datePublished": interview.data.date.toISOString(),
      "author": {
        "@type": "Person",
        "name": "William Hesketh"
      }
    },
    {
      "@type": "Person",
      "name": interview.data.interviewee,
      "jobTitle": interview.data.role,
      "worksFor": {
        "@type": "Organization",
        "name": interview.data.company
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": (Astro.site || Astro.url.origin).toString()
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Interviews",
          "item": new URL("/interviews", Astro.site || Astro.url.origin).toString()
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": interview.data.title,
          "item": new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString()
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${interview.data.title} | Ride The Tiger`}
  description={seoDescription}
  image={imagePath}
  type="article"
  keywords={interview.data.tags}
  publishedTime={interview.data.date}
  schema={schema}
>
  <article
    id="rtt-interview-article"
    data-interview-slug={interview.id}
    class="bg-white border-b-8 border-tiger-500"
  >
    <header class="container mx-auto px-6 max-w-4xl py-20 lg:py-32">
      <div class="mb-8 flex flex-wrap justify-between gap-4 items-center">
        <div id="interview-tags-list" class="flex flex-wrap gap-3 items-center">
          {interview.data.tags.map(tag => (
            <span class="bg-[var(--color-charcoal)] text-[var(--color-offwhite)] text-xs font-bold uppercase tracking-widest px-3 py-1">
              {tag}
            </span>
          ))}
        </div>

        <a
          id="interview-edit-studio-link"
          href={`/admin?edit=${interview.id}`}
          class="text-xs font-bold uppercase tracking-widest text-tiger-600 hover:text-tiger-500 border border-tiger-500 px-3 py-1 transition-colors"
        >
          Edit in /admin &rarr;
        </a>
      </div>

      <h1
        id="interview-title"
        class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.9] mb-12"
      >
        {interview.data.title}
      </h1>

      <div
        class="w-full bg-gray-200 border-b-8 border-tiger-500 overflow-hidden shadow-2xl mb-12"
        style="aspect-ratio: 1200/628"
      >
        <img
          id="interview-hero-img"
          src={imagePath}
          alt={interview.data.coverImageAlt || `Cover image for ${interview.data.interviewee}`}
          class="w-full h-full object-cover hover:scale-105 hover:brightness-110 transition-all duration-700"
          width="1200"
          height="628"
          fetchpriority="high"
        />
      </div>
      
      <blockquote
        id="interview-quote"
        class="pull-quote text-2xl md:text-4xl max-w-3xl mb-12"
      >
        "{interview.data.quote}"
      </blockquote>

      <div class="flex flex-wrap gap-x-12 gap-y-6 pt-8 border-t-2 border-[var(--color-charcoal)] mt-12">
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Published</h4>
          <p class="text-lg text-[var(--color-charcoal)]">
            <time id="interview-date" datetime={interview.data.date.toISOString()}>
              {interview.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          </p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Interviewee</h4>
          <p id="interview-person" class="text-lg font-bold text-[var(--color-charcoal)]">{interview.data.interviewee}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Role</h4>
          <p id="interview-role" class="text-lg text-[var(--color-charcoal)]">{interview.data.role}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Company</h4>
          <p id="interview-company" class="text-lg text-[var(--color-charcoal)]">{interview.data.company}</p>
        </div>
        <div>
          <h4 class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Read Time</h4>
          <p id="interview-readtime" class="text-lg text-[var(--color-charcoal)]">{interview.data.readTime}</p>
        </div>
      </div>
    </header>

    <div class="bg-[var(--color-offwhite)] py-16 lg:py-20 border-t border-gray-200">
      <div class="container mx-auto px-6 max-w-3xl">
        <!-- SUBSTACK-STYLE AUDIO NARRATION PLAYER -->
        <div
          id="rtt-audio-player-card"
          class="mb-12 bg-[var(--color-charcoal)] text-[var(--color-offwhite)] border-b-4 border-tiger-500 p-5 sm:p-6 shadow-xl"
        >
          <audio
            id="rtt-narration-audio"
            preload="metadata"
            src={initialAudioUrl}
          ></audio>

          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-6 h-6 bg-tiger-500 text-[var(--color-charcoal)]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
                  <path d="M12 3a9 9 0 0 0-9 9v7c0 1.1.9 2 2 2h3v-8H5v-1a7 7 0 0 1 14 0v1h-3v8h3c1.1 0 2-.9 2-2v-7a9 9 0 0 0-9-9Z" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-black uppercase tracking-widest text-tiger-500 m-0">
                  Listen to This Interview
                </p>
                <p id="rtt-audio-subtitle" class="text-[11px] text-gray-300 m-0">
                  Audio narration &middot; UK English &middot; Jumps straight into the interview
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="rtt-audio-back-15"
                class="px-2.5 py-1 bg-white/10 hover:bg-white/20 text-xs font-bold uppercase tracking-wider text-offwhite cursor-pointer transition-colors"
                title="Rewind 15 seconds"
              >
                -15s
              </button>
              <button
                type="button"
                id="rtt-audio-fwd-15"
                class="px-2.5 py-1 bg-white/10 hover:bg-white/20 text-xs font-bold uppercase tracking-wider text-offwhite cursor-pointer transition-colors"
                title="Fast-forward 15 seconds"
              >
                +15s
              </button>
              <button
                type="button"
                id="rtt-audio-speed-btn"
                class="px-2.5 py-1 bg-tiger-500/20 hover:bg-tiger-500/30 border border-tiger-500/50 text-xs font-black uppercase tracking-wider text-tiger-500 cursor-pointer transition-colors min-w-[3.25rem]"
                title="Change playback speed"
              >
                1&times;
              </button>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <button
              type="button"
              id="rtt-audio-play-btn"
              aria-label="Play interview narration"
              class="w-12 h-12 shrink-0 bg-tiger-500 hover:bg-tiger-600 text-[var(--color-charcoal)] flex items-center justify-center cursor-pointer transition-colors shadow-md"
            >
              <!-- Play Icon -->
              <svg id="rtt-icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 ml-0.5">
                <path d="M8 5.14v14l11-7-11-7Z" />
              </svg>
              <!-- Pause Icon -->
              <svg id="rtt-icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 hidden">
                <path d="M6 19h4V5H6v14Zm8-14v14h4V5h-4Z" />
              </svg>
            </button>

            <div class="flex-1 space-y-1.5">
              <input
                id="rtt-audio-seek"
                type="range"
                min="0"
                max="1000"
                step="1"
                value="0"
                aria-label="Seek audio position"
                class="w-full accent-[var(--color-tiger-500)] cursor-pointer h-1.5 bg-gray-700"
              />
              <div class="flex items-center justify-between text-[11px] font-mono text-gray-300">
                <span id="rtt-audio-current">0:00</span>
                <span id="rtt-audio-duration">{interview.data.readTime.replace(/read/i, 'listen')}</span>
              </div>
            </div>
          </div>
        </div>

        <div
          id="interview-body-container"
          class="prose prose-lg prose-neutral max-w-none 
          prose-h2:text-3xl prose-h2:font-bold prose-h2:uppercase prose-h2:tracking-tight prose-h2:mt-16 prose-h2:mb-8
          prose-h3:text-3xl prose-h3:font-bold prose-h3:uppercase prose-h3:tracking-tight prose-h3:mt-16 prose-h3:mb-8
          prose-p:leading-relaxed prose-p:mb-8
          prose-strong:text-[var(--color-charcoal)] prose-strong:font-black"
          set:html={renderedArticleHtml}
        />
      </div>
    </div>
    
    <div
      id="interview-related-section"
      hidden={relatedInterviews.length === 0}
      class="bg-gray-100 py-20"
    >
      <div class="container mx-auto px-6 max-w-4xl">
        <h3 class="text-3xl font-bold uppercase tracking-tight mb-10">Related Interviews</h3>
        <div id="interview-related-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {relatedInterviews.map(related => {
            const relImg = resolveInterviewImage(related.data);
            return (
              <a href={`/interviews/${related.id}`} class="block group">
                <div class="bg-white p-6 shadow-md border-b-4 border-transparent group-hover:border-tiger-500 transition-colors h-full flex flex-col">
                  <div class="mb-4">
                    <img src={relImg} alt={related.data.interviewee} class="w-16 h-16 rounded-full object-cover mb-4" loading="lazy" width="64" height="64" />
                    <h4 class="font-bold text-lg leading-tight uppercase group-hover:text-tiger-600 transition-colors">{related.data.title}</h4>
                  </div>
                  <p class="text-gray-600 text-sm mt-auto">Featuring {related.data.interviewee}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </article>
</Layout>

<script>
  import {
    renderMarkdownWithInlineImages,
    resolveInterviewImage,
    escapeHtml,
  } from '../../utils/articleRenderer';

  const INTERVIEWS_STORAGE_KEY = 'rtt_cms_interviews_v1';

  function initInterviewDetailHydration() {
    const articleEl = document.getElementById('rtt-interview-article');
    if (!articleEl) return;

    const urlSlug = decodeURIComponent(
      window.location.pathname.replace(/^\/interviews\//, '').replace(/\/+$/, '')
    );
    const activeSlug = urlSlug || articleEl.dataset.interviewSlug || '';
    if (!activeSlug) return;

    const editLink = document.getElementById('interview-edit-studio-link') as HTMLAnchorElement | null;
    if (editLink) {
      editLink.href = `/admin?edit=${encodeURIComponent(activeSlug)}`;
    }

    function applyInterviewFromList(list: any[]) {
      if (!Array.isArray(list) || list.length === 0) return;
      const post = list.find((item) => item && item.slug === activeSlug);
      if (!post) return;

      document.title = `${post.title} | Ride The Tiger`;

      const titleEl = document.getElementById('interview-title');
      if (titleEl && post.title) titleEl.textContent = post.title;

      const tagsEl = document.getElementById('interview-tags-list');
      if (tagsEl && Array.isArray(post.tags)) {
        tagsEl.innerHTML = post.tags
          .map(
            (t: string) =>
              `<span class="bg-[var(--color-charcoal)] text-[var(--color-offwhite)] text-xs font-bold uppercase tracking-widest px-3 py-1">${escapeHtml(t)}</span>`
          )
          .join('');
      }

      const heroImg = document.getElementById('interview-hero-img') as HTMLImageElement | null;
      const imgPath = resolveInterviewImage(post);
      if (heroImg && imgPath) {
        heroImg.src = imgPath;
        heroImg.alt = post.coverImageAlt || `Cover image for ${post.interviewee || ''}`;
      }

      const quoteEl = document.getElementById('interview-quote');
      if (quoteEl && post.quote !== undefined) {
        const cleanQuote = String(post.quote || '').replace(/^[“"']|[”"']$/g, '');
        quoteEl.textContent = `"${cleanQuote}"`;
      }

      const dateEl = document.getElementById('interview-date');
      if (dateEl && post.date) {
        const dt = new Date(post.date);
        if (!isNaN(dt.valueOf())) {
          dateEl.setAttribute('datetime', dt.toISOString());
          dateEl.textContent = dt.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          });
        }
      }

      const personEl = document.getElementById('interview-person');
      if (personEl && post.interviewee) personEl.textContent = post.interviewee;

      const roleEl = document.getElementById('interview-role');
      if (roleEl && post.role) roleEl.textContent = post.role;

      const companyEl = document.getElementById('interview-company');
      if (companyEl && post.company) companyEl.textContent = post.company;

      const readTimeEl = document.getElementById('interview-readtime');
      if (readTimeEl && post.readTime) readTimeEl.textContent = post.readTime;

      const bodyEl = document.getElementById('interview-body-container');
      if (bodyEl && typeof post.body === 'string') {
        bodyEl.innerHTML = renderMarkdownWithInlineImages(
          post.body,
          Array.isArray(post.inlineImages) ? post.inlineImages : []
        );
      }

      const audioEl = document.getElementById('rtt-narration-audio') as HTMLAudioElement | null;
      if (audioEl) {
        const expectedAudioUrl = post.audioUrl || `/audio/${post.slug}.mp3`;
        if (audioEl.getAttribute('src') !== expectedAudioUrl && audioEl.paused) {
          audioEl.setAttribute('src', expectedAudioUrl);
        }
      }

      // Related interviews hydration
      const relatedSection = document.getElementById('interview-related-section');
      const relatedGrid = document.getElementById('interview-related-grid');
      if (relatedSection && relatedGrid) {
        const postTags: string[] = Array.isArray(post.tags) ? post.tags : [];
        const related = list
          .filter(
            (i) =>
              i &&
              i.slug !== post.slug &&
              Array.isArray(i.tags) &&
              i.tags.some((t: string) => postTags.includes(t))
          )
          .slice(0, 3);

        if (related.length > 0) {
          relatedSection.hidden = false;
          relatedGrid.innerHTML = related
            .map((rel) => {
              const relImg = resolveInterviewImage(rel);
              return `
                <a href="/interviews/${escapeHtml(rel.slug)}" class="block group">
                  <div class="bg-white p-6 shadow-md border-b-4 border-transparent group-hover:border-tiger-500 transition-colors h-full flex flex-col">
                    <div class="mb-4">
                      <img src="${escapeHtml(relImg)}" alt="${escapeHtml(rel.interviewee)}" class="w-16 h-16 rounded-full object-cover mb-4" loading="lazy" width="64" height="64" />
                      <h4 class="font-bold text-lg leading-tight uppercase group-hover:text-tiger-600 transition-colors">${escapeHtml(rel.title)}</h4>
                    </div>
                    <p class="text-gray-600 text-sm mt-auto">Featuring ${escapeHtml(rel.interviewee)}</p>
                  </div>
                </a>
              `;
            })
            .join('');
        } else {
          relatedSection.hidden = true;
        }
      }
    }

    let localList: any[] | null = null;
    try {
      const raw = localStorage.getItem(INTERVIEWS_STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) {
          localList = parsed;
          applyInterviewFromList(parsed);
        }
      }
    } catch {
      // ignore
    }

    fetch('/__cms-sync', { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((cloud) => {
        if (!cloud || !cloud.ok) return;
        if (Array.isArray(cloud.interviews) && cloud.interviews.length > 0) {
          localStorage.setItem(INTERVIEWS_STORAGE_KEY, JSON.stringify(cloud.interviews));
          applyInterviewFromList(cloud.interviews);
        } else if (localList && localList.length > 0) {
          fetch('/__cms-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'sync-interviews', items: localList }),
          }).catch(() => {});
        }
      })
      .catch(() => {});
  }

  function initNarrationAudioPlayer() {
    const audioEl = document.getElementById('rtt-narration-audio') as HTMLAudioElement | null;
    const playBtn = document.getElementById('rtt-audio-play-btn') as HTMLButtonElement | null;
    const iconPlay = document.getElementById('rtt-icon-play');
    const iconPause = document.getElementById('rtt-icon-pause');
    const seekInput = document.getElementById('rtt-audio-seek') as HTMLInputElement | null;
    const currentEl = document.getElementById('rtt-audio-current');
    const durationEl = document.getElementById('rtt-audio-duration');
    const back15Btn = document.getElementById('rtt-audio-back-15');
    const fwd15Btn = document.getElementById('rtt-audio-fwd-15');
    const speedBtn = document.getElementById('rtt-audio-speed-btn');
    const subtitleEl = document.getElementById('rtt-audio-subtitle');

    if (!audioEl || !playBtn || playBtn.dataset.bound === 'true') return;
    playBtn.dataset.bound = 'true';

    const speeds = [1, 1.25, 1.5, 1.75, 2];
    let speedIdx = 0;
    let isSeeking = false;
    let isGeneratingOnDemand = false;
    let usingWebSpeechFallback = false;

    function formatTime(sec: number): string {
      if (!isFinite(sec) || sec < 0) return '0:00';
      const total = Math.floor(sec);
      const mins = Math.floor(total / 60);
      const secs = total % 60;
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function setPlayingUi(playing: boolean) {
      if (iconPlay && iconPause) {
        iconPlay.classList.toggle('hidden', playing);
        iconPause.classList.toggle('hidden', !playing);
      }
      playBtn?.setAttribute(
        'aria-label',
        playing ? 'Pause interview narration' : 'Play interview narration'
      );
    }

    function startBrowserUkFemaleSpeechFallback() {
      if (!('speechSynthesis' in window)) return;
      const bodyEl = document.getElementById('interview-body-container');
      const rawText = (bodyEl?.innerText || '').trim();
      if (!rawText) return;

      usingWebSpeechFallback = true;
      window.speechSynthesis.cancel();

      const utterance = new SpeechSynthesisUtterance(rawText);
      utterance.lang = 'en-GB';
      utterance.rate = speeds[speedIdx];

      const voices = window.speechSynthesis.getVoices();
      const ukFemale =
        voices.find(
          (v) =>
            /en[-_]GB/i.test(v.lang) &&
            /sonia|libby|serena|kate|martha|female|hazel|susan/i.test(v.name)
        ) ||
        voices.find((v) => /en[-_]GB/i.test(v.lang)) ||
        voices.find((v) => /^en/i.test(v.lang));

      if (ukFemale) utterance.voice = ukFemale;

      utterance.onstart = () => setPlayingUi(true);
      utterance.onend = () => {
        usingWebSpeechFallback = false;
        setPlayingUi(false);
      };
      utterance.onerror = () => {
        usingWebSpeechFallback = false;
        setPlayingUi(false);
      };

      window.speechSynthesis.speak(utterance);
      setPlayingUi(true);
    }

    async function ensureAudioOrGenerateAndPlay() {
      if (isGeneratingOnDemand) return;

      try {
        await audioEl!.play();
        setPlayingUi(true);
        return;
      } catch {
        // If the MP3 does not exist yet (e.g. brand-new article created in browser), generate it on the fly
      }

      const bodyEl = document.getElementById('interview-body-container');
      const bodyText = (bodyEl?.innerText || '').trim();
      if (!bodyText) return;

      const articleEl = document.getElementById('rtt-interview-article');
      const slug =
        decodeURIComponent(
          window.location.pathname.replace(/^\/interviews\//, '').replace(/\/+$/, '')
        ) ||
        articleEl?.dataset.interviewSlug ||
        'interview';

      isGeneratingOnDemand = true;
      if (subtitleEl) {
        subtitleEl.textContent = 'Generating UK Female audio narration...';
      }

      try {
        const res = await fetch('/__cms-sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'generate-audio',
            slug,
            body: bodyText,
            voice: 'en-GB-SoniaNeural',
          }),
        });
        if (res.ok) {
          const json = await res.json();
          if (json.ok && json.audioUrl) {
            audioEl!.src = json.audioUrl;
            audioEl!.playbackRate = speeds[speedIdx];
            if (subtitleEl) {
              subtitleEl.textContent =
                'Audio narration · UK English · Jumps straight into the interview';
            }
            await audioEl!.play();
            setPlayingUi(true);
            isGeneratingOnDemand = false;
            return;
          }
        }
      } catch {
        // Fall through to Web Speech UK female fallback
      }

      isGeneratingOnDemand = false;
      if (subtitleEl) {
        subtitleEl.textContent =
          'Audio narration · UK English · Jumps straight into the interview';
      }
      startBrowserUkFemaleSpeechFallback();
    }

    playBtn.addEventListener('click', () => {
      if (usingWebSpeechFallback && 'speechSynthesis' in window) {
        if (window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
          window.speechSynthesis.pause();
          setPlayingUi(false);
        } else if (window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
          setPlayingUi(true);
        } else {
          startBrowserUkFemaleSpeechFallback();
        }
        return;
      }

      if (audioEl.paused) {
        ensureAudioOrGenerateAndPlay();
      } else {
        audioEl.pause();
        setPlayingUi(false);
      }
    });

    audioEl.addEventListener('play', () => {
      setPlayingUi(true);
      if ('mediaSession' in navigator) {
        const title = document.getElementById('interview-title')?.textContent || 'Interview';
        const interviewee = document.getElementById('interview-person')?.textContent || 'Ride The Tiger';
        const heroImg = (document.getElementById('interview-hero-img') as HTMLImageElement | null)?.src;
        navigator.mediaSession.metadata = new MediaMetadata({
          title,
          artist: `${interviewee} — Ride The Tiger`,
          album: 'Ride The Tiger Interviews',
          artwork: heroImg ? [{ src: heroImg }] : [],
        });
      }
    });

    audioEl.addEventListener('pause', () => setPlayingUi(false));
    audioEl.addEventListener('ended', () => {
      setPlayingUi(false);
      if (seekInput) seekInput.value = '0';
      if (currentEl) currentEl.textContent = '0:00';
    });

    audioEl.addEventListener('loadedmetadata', () => {
      if (durationEl && isFinite(audioEl.duration) && audioEl.duration > 0) {
        durationEl.textContent = formatTime(audioEl.duration);
      }
    });

    audioEl.addEventListener('timeupdate', () => {
      if (currentEl) {
        currentEl.textContent = formatTime(audioEl.currentTime);
      }
      if (
        !isSeeking &&
        seekInput &&
        isFinite(audioEl.duration) &&
        audioEl.duration > 0
      ) {
        seekInput.value = String(
          Math.round((audioEl.currentTime / audioEl.duration) * 1000)
        );
      }
    });

    seekInput?.addEventListener('input', () => {
      isSeeking = true;
      if (isFinite(audioEl.duration) && audioEl.duration > 0 && currentEl) {
        const targetTime = (Number(seekInput.value) / 1000) * audioEl.duration;
        currentEl.textContent = formatTime(targetTime);
      }
    });

    seekInput?.addEventListener('change', () => {
      if (isFinite(audioEl.duration) && audioEl.duration > 0) {
        audioEl.currentTime = (Number(seekInput.value) / 1000) * audioEl.duration;
      }
      isSeeking = false;
    });

    back15Btn?.addEventListener('click', () => {
      if (isFinite(audioEl.duration)) {
        audioEl.currentTime = Math.max(0, audioEl.currentTime - 15);
      }
    });

    fwd15Btn?.addEventListener('click', () => {
      if (isFinite(audioEl.duration)) {
        audioEl.currentTime = Math.min(audioEl.duration, audioEl.currentTime + 15);
      }
    });

    speedBtn?.addEventListener('click', () => {
      speedIdx = (speedIdx + 1) % speeds.length;
      const nextRate = speeds[speedIdx];
      audioEl.playbackRate = nextRate;
      speedBtn.innerHTML = `${nextRate}&times;`;
    });
  }

  initInterviewDetailHydration();
  initNarrationAudioPlayer();
  document.addEventListener('astro:page-load', () => {
    initInterviewDetailHydration();
    initNarrationAudioPlayer();
  });
</script>
