---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ride The Tiger | Editorial Series on Creative Survival">
  <!-- Hero Section -->
  <section class="container mx-auto px-6 max-w-5xl py-20 lg:py-32">
    <div class="mb-4 inline-block bg-charcoal text-tiger-500 font-bold uppercase tracking-widest text-xs px-3 py-1">
      An Editorial Series on Creative Survival
    </div>
    <h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase leading-[0.9] mb-8">
      Stop fighting<br/>the machine.<br/>
      <span class="text-tiger-600">Learn to ride<br/>the tiger.</span>
    </h1>
    <p class="text-xl md:text-2xl text-gray-700 max-w-2xl leading-relaxed mb-10">
      Candid, unfiltered conversations with copywriters, designers, and agency leaders navigating the real impact of AI on craft, commerce, and the creative psyche.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/interviews" class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-8 py-4 uppercase tracking-wider transition-colors">Read the Interviews</a>
      <a href="/about" class="border-2 border-charcoal hover:bg-charcoal hover:text-offwhite text-charcoal font-bold px-8 py-4 uppercase tracking-wider transition-colors">About the Project</a>
    </div>
  </section>

  <!-- Pull Quote Banner -->
  <section class="bg-charcoal text-offwhite py-20 border-y-4 border-tiger-500 relative z-10 shadow-xl">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <blockquote class="text-3xl md:text-5xl font-serif italic leading-tight text-tiger-500">
        "The creative industry is stuck in a dead-end debate between doom-mongering Luddites and breathless tech evangelists. We document what's actually happening in the messy middle."
      </blockquote>
    </div>
  </section>

  <!-- Four Core Themes with Parallax -->
  <section class="container mx-auto px-6 max-w-5xl py-32 overflow-clip relative z-0">
    <h2 class="text-4xl font-bold uppercase tracking-tighter mb-16 text-center">The Four Questions We Ask Everyone</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 parallax-wrapper pb-16">
      <div class="border border-gray-200 p-10 hover:border-tiger-500 transition-colors bg-white shadow-sm parallax-layer" style="--parallax-offset: 80px">
        <h3 class="text-2xl font-bold uppercase tracking-tight mb-4">1. The Bleed <span class="text-gray-400 font-normal lowercase">(Where AI Kills)</span></h3>
        <p class="text-gray-700 leading-relaxed text-lg">The lost billable hours, commoditized skills, and creative compromises no one wants to admit out loud.</p>
      </div>
      <div class="border border-gray-200 p-10 hover:border-tiger-500 transition-colors bg-white shadow-sm parallax-layer" style="--parallax-offset: 160px">
        <h3 class="text-2xl font-bold uppercase tracking-tight mb-4">2. The Leverage <span class="text-gray-400 font-normal lowercase">(Where AI Empowers)</span></h3>
        <p class="text-gray-700 leading-relaxed text-lg">The tactical workflows, secret speed runs, and superpower tools making creatives faster and bolder.</p>
      </div>
      <div class="border border-gray-200 p-10 hover:border-tiger-500 transition-colors bg-white shadow-sm parallax-layer" style="--parallax-offset: 240px">
        <h3 class="text-2xl font-bold uppercase tracking-tight mb-4">3. The Horizon <span class="text-gray-400 font-normal lowercase">(Where Craft Goes Next)</span></h3>
        <p class="text-gray-700 leading-relaxed text-lg">Honest, hype-free projections on how brand storytelling, design, and commercial creative work are shifting.</p>
      </div>
      <div class="border border-gray-200 p-10 hover:border-tiger-500 transition-colors bg-white shadow-sm parallax-layer" style="--parallax-offset: 320px">
        <h3 class="text-2xl font-bold uppercase tracking-tight mb-4">4. The Psyche <span class="text-gray-400 font-normal lowercase">(How It Feels)</span></h3>
        <p class="text-gray-700 leading-relaxed text-lg">Beyond the bottom line—tackling burnout, identity crises, and rediscovering joy in human expression.</p>
      </div>
    </div>
    
    <div class="mt-8 text-center parallax-layer" style="--parallax-offset: 50px">
      <a href="/interviews" class="inline-block bg-tiger-500 hover:bg-tiger-600 text-[var(--color-charcoal)] font-bold px-10 py-5 uppercase tracking-wider transition-colors shadow-lg">Read the Interviews</a>
    </div>
  </section>
</Layout>

<style>
@keyframes parallax {
  from {
    transform: translateY(var(--parallax-offset, 100px));
  }
}

.parallax-wrapper {
  view-timeline: --parallax-wrapper;
}

.parallax-layer {
  animation: parallax ease-out both;
  animation-timeline: --parallax-wrapper;
  animation-range: entry 0% cover 30%;
}

@media (prefers-reduced-motion: reduce) {
  .parallax-layer {
    animation: none;
  }
}
</style>

<script>
if (!CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
  const wrapper = document.querySelector('.parallax-wrapper');
  const layers = document.querySelectorAll('.parallax-layer');

  if (wrapper && layers.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          window.addEventListener('scroll', onScroll);
        } else {
          window.removeEventListener('scroll', onScroll);
        }
      });
    }, { threshold: 0 });

    observer.observe(wrapper);

    function onScroll() {
      const scrollY = window.scrollY;
      const wrapperRect = wrapper.getBoundingClientRect();
      const wrapperTop = wrapperRect.top + scrollY;
      const windowHeight = window.innerHeight;

      if (scrollY + windowHeight >= wrapperTop) {
        const scrollPercent = Math.max(0, Math.min(1, (scrollY + windowHeight - wrapperTop) / windowHeight));
        
        layers.forEach((layer) => {
          const offsetStr = layer.getAttribute('style')?.match(/--parallax-offset:\s*(\d+)px/);
          const offset = offsetStr ? parseFloat(offsetStr[1]) : 100;
          const translateY = offset * (1 - scrollPercent);
          layer.setAttribute('style', `--parallax-offset: ${offset}px; transform: translateY(${translateY}px)`);
        });
      }
    }
    onScroll();
  }
}
</script>
