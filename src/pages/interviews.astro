---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import InterviewFilter from '../components/InterviewFilter';
import siteContent from '../data/site-content.json';

const interviewsPage = siteContent.interviewsPage || {};
const allInterviews = await getCollection('interviews');
const sortedInterviews = allInterviews.sort((a, b) => {
  if (typeof a.data.order === 'number' && typeof b.data.order === 'number') {
    return a.data.order - b.data.order;
  }
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---
<Layout title={siteContent.seo?.interviewsTitle || "Interviews | Ride The Tiger"}>
  <div class="container mx-auto px-6 max-w-5xl py-20 min-h-screen">
    <header class="mb-16 border-b-4 border-tiger-500 pb-8 inline-block">
      <h1
        data-cms-text="interviewsPage.heading"
        class="text-5xl font-bold tracking-tight mb-4 font-sans uppercase"
      >
        {interviewsPage.heading || "The Interviews"}
      </h1>
      <p
        data-cms-text="interviewsPage.subheading"
        class="text-2xl text-gray-500 font-serif italic"
      >
        {interviewsPage.subheading || "Unfiltered conversations on creative survival."}
      </p>
    </header>
    <InterviewFilter
      client:load
      interviews={sortedInterviews.map((i, idx) => ({
        slug: i.id,
        data: {
          ...i.data,
          order: i.data.order ?? idx + 1,
        },
      }))}
    />
  </div>
</Layout>
