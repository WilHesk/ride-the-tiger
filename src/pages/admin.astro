---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import siteContent from "../data/site-content.json";
import adminAccounts from "../data/admin-accounts.json";
import { resolveInterviewImage } from "../utils/articleRenderer";

const allInterviews = await getCollection("interviews");
const sortedInterviews = allInterviews.sort((a, b) => {
  if (typeof a.data.order === "number" && typeof b.data.order === "number") {
    return a.data.order - b.data.order;
  }
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const initialInterviewsData = sortedInterviews.map((entry, idx) => ({
  slug: entry.id,
  title: entry.data.title,
  interviewee: entry.data.interviewee,
  role: entry.data.role,
  company: entry.data.company,
  date: entry.data.date.toISOString().split("T")[0],
  readTime: entry.data.readTime,
  excerpt: entry.data.excerpt,
  quote: entry.data.quote,
  tags: entry.data.tags || [],
  order: entry.data.order ?? idx + 1,
  coverImage: resolveInterviewImage(entry.data),
  coverImageAlt:
    entry.data.coverImageAlt || `Cover image for ${entry.data.interviewee}`,
  inlineImages: Array.isArray(entry.data.inlineImages)
    ? entry.data.inlineImages
    : [],
  googleDriveFolderUrl: entry.data.googleDriveFolderUrl || "",
  body: (entry.body || "").trim(),
}));

const imageChoices = [
  { label: "Joe Emery (Headshot)", src: "/headshots/Joe Emery.webp" },
  { label: "Martin Sayers (Headshot)", src: "/headshots/Martin Sayers.webp" },
  {
    label: "Cecilie Conradsen (Headshot)",
    src: "/headshots/Cecilie Conradsen.webp",
  },
  { label: "Romey Norton (Headshot)", src: "/headshots/Romey Norton.webp" },
  {
    label: "Daniel Schmergel (Headshot)",
    src: "/headshots/Daniel Schmergel.png",
  },
  { label: "Helen Carrie (Headshot)", src: "/headshots/Helen Carrie.png" },
  { label: "Steph Spector (Headshot)", src: "/headshots/Steph Spector.png" },
];
---

<Layout
  title="Contributor Studio & Admin | Ride The Tiger"
  description="Import interviews from a Google Docs folder, position inline images by percentage, and edit all posts and site copy in the browser."
>
  <script
    is:inline
    src="https://identity.netlify.com/v1/netlify-identity-widget.js"
  ></script>

  <!-- Studio Header Banner -->
  <section class="bg-charcoal text-offwhite py-12 border-b-4 border-tiger-500">
    <div class="container mx-auto px-6 max-w-6xl flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <div>
        <div class="mb-2 inline-block bg-tiger-500 text-charcoal font-bold uppercase tracking-widest text-xs px-3 py-1">
          Browser CMS &amp; Google Docs Folder Importer
        </div>
        <h1 class="text-4xl sm:text-5xl font-black uppercase tracking-tighter text-offwhite">
          Ride The Tiger Studio
        </h1>
        <p class="text-gray-300 text-base sm:text-lg mt-2 max-w-2xl">
          Paste a Google Docs folder link to auto-create interview posts with percentage-positioned inline images, or edit every post and page across the site.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-5 text-xs font-bold uppercase tracking-wider">
        <a href="/" class="text-offwhite hover:text-tiger-500 transition-colors">View Home &rarr;</a>
        <a href="/interviews" class="text-offwhite hover:text-tiger-500 transition-colors">View /interviews &rarr;</a>
        <a href="/about" class="text-offwhite hover:text-tiger-500 transition-colors">View /about &rarr;</a>
        <button
          type="button"
          id="admin-logout-btn"
          hidden
          class="bg-transparent border border-tiger-500 text-tiger-500 hover:bg-tiger-500 hover:text-charcoal px-3 py-1.5 uppercase tracking-wider text-xs font-bold cursor-pointer transition-colors"
        >
          Sign out
        </button>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container mx-auto px-6 max-w-6xl">
      <!-- =====================================================
           1. OWNER AUTHENTICATION GATE (wilhesk@gmail.com)
           ===================================================== -->
      <div
        id="admin-login-panel"
        class="max-w-lg mx-auto p-8 sm:p-10 bg-white border-2 border-charcoal shadow-xl space-y-6"
      >
        <div class="p-5 bg-gray-100 border border-gray-300 space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-lg font-black uppercase tracking-tight text-charcoal m-0">
                Sign in with Netlify
              </h2>
              <p class="text-xs text-gray-600 m-0 mt-0.5">
                Linked to owner account <strong class="text-charcoal">wilhesk@gmail.com</strong>
              </p>
            </div>
            <button
              type="button"
              id="netlify-login-btn"
              class="bg-charcoal hover:bg-tiger-600 text-offwhite font-bold px-4 py-2 text-xs uppercase tracking-wider cursor-pointer transition-colors"
            >
              Log in with Netlify &rarr;
            </button>
          </div>
          <p id="netlify-auth-status" role="status" class="text-xs font-bold text-tiger-600 m-0"></p>

          <div id="netlify-pat-drawer" hidden class="pt-3 border-t border-gray-300 space-y-3">
            <p class="text-xs text-gray-700 m-0">
              Paste a <a href="https://app.netlify.com/user/applications#personal-access-tokens" target="_blank" rel="noopener noreferrer" class="text-tiger-600 underline font-bold">Netlify Personal Access Token ↗</a> to verify your Netlify account directly:
            </p>
            <form id="netlify-token-form" class="space-y-2">
              <input
                id="netlify-pat-input"
                type="password"
                required
                placeholder="nfp_••••••••••••••••••••••••"
                class="w-full px-3 py-2 border border-gray-400 bg-white text-charcoal text-sm"
              />
              <button
                type="submit"
                class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-4 py-2 text-xs uppercase tracking-wider cursor-pointer"
              >
                Verify Netlify Token &amp; Enter Studio
              </button>
            </form>
          </div>
        </div>

        <!-- VIEW A: SIGN IN -->
        <div id="auth-view-signin">
          <h3 class="text-2xl font-black uppercase tracking-tight text-charcoal mb-1">
            Or sign in with Password
          </h3>
          <p class="text-sm text-gray-600 mb-5">
            Owner sign-in for <strong class="text-charcoal">wilhesk@gmail.com</strong> (works with Google Password Manager).
          </p>

          <form id="admin-login-form" method="POST" action="/admin" class="space-y-5">
            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                Owner Email Address
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                value="wilhesk@gmail.com"
                autocomplete="username"
                class="w-full px-4 py-2.5 border border-gray-400 bg-gray-50 text-charcoal"
              />
            </div>

            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <label for="current-password" class="block text-xs font-bold uppercase tracking-wider text-charcoal">
                  Password
                </label>
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    id="toggle-login-password"
                    class="text-xs font-bold text-gray-600 hover:text-charcoal bg-transparent border-0 p-0 cursor-pointer underline"
                  >
                    Show password
                  </button>
                  <button
                    type="button"
                    id="open-forgot-password-btn"
                    class="text-xs font-bold text-tiger-600 hover:text-tiger-500 bg-transparent border-0 p-0 cursor-pointer underline"
                  >
                    Set / Reset password
                  </button>
                </div>
              </div>
              <input
                id="current-password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full px-4 py-2.5 border border-gray-400 bg-gray-50 text-charcoal"
              />
            </div>

            <p id="login-error-msg" role="alert" class="text-sm font-bold text-tiger-600 m-0 min-h-[1.25rem]"></p>

            <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200">
              <button
                type="submit"
                class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-6 py-3 uppercase tracking-wider text-sm cursor-pointer transition-colors"
              >
                Sign in to Studio &rarr;
              </button>
              <button
                type="button"
                id="open-signup-view-btn"
                class="text-xs font-bold text-gray-600 hover:text-charcoal underline bg-transparent border-0 p-0 cursor-pointer"
              >
                First time? Choose password
              </button>
            </div>
          </form>
        </div>

        <!-- VIEW B: CHOOSE / RESET PASSWORD -->
        <div id="auth-view-signup" hidden>
          <h3 class="text-2xl font-black uppercase tracking-tight text-charcoal mb-1">
            Choose Studio Password
          </h3>
          <p class="text-sm text-gray-600 mb-5">
            Choose a password (at least 8 characters) for <strong class="text-charcoal">wilhesk@gmail.com</strong>.
          </p>

          <form id="admin-signup-form" method="POST" action="/admin" class="space-y-5">
            <div>
              <label for="signup-email" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                Owner Email
              </label>
              <input
                id="signup-email"
                name="email"
                type="email"
                readonly
                value="wilhesk@gmail.com"
                autocomplete="username"
                class="w-full px-4 py-2.5 border border-gray-300 bg-gray-200 text-charcoal"
              />
            </div>

            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <label for="new-password" class="block text-xs font-bold uppercase tracking-wider text-charcoal">
                  New Password
                </label>
                <button
                  type="button"
                  id="toggle-signup-password"
                  class="text-xs font-bold text-gray-600 underline bg-transparent border-0 p-0 cursor-pointer"
                >
                  Show password
                </button>
              </div>
              <input
                id="new-password"
                name="new-password"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="Click here to choose or auto-generate password"
                class="w-full px-4 py-2.5 border border-gray-400 bg-gray-50 text-charcoal"
              />
            </div>

            <p id="signup-error-msg" role="alert" class="text-sm font-bold text-tiger-600 m-0 min-h-[1.25rem]"></p>

            <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200">
              <button
                type="submit"
                class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-6 py-3 uppercase tracking-wider text-sm cursor-pointer transition-colors"
              >
                Save Password &amp; Enter Studio &rarr;
              </button>
              <button
                type="button"
                id="back-to-signin-btn"
                class="text-xs font-bold text-gray-600 underline bg-transparent border-0 p-0 cursor-pointer"
              >
                Back to sign in
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- =====================================================
           2. AUTHENTICATED STUDIO WORKSPACE
           ===================================================== -->
      <div id="admin-studio-workspace" hidden class="space-y-8 pb-20">
        <!-- Sticky Top Studio Bar -->
        <div class="sticky top-[4.5rem] z-40 bg-white/95 backdrop-blur-md p-4 border-2 border-charcoal shadow-md flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Studio sections">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              data-studio-tab="gdrive"
              class="studio-tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider border cursor-pointer transition-colors bg-charcoal text-tiger-500 border-charcoal"
            >
              1. Google Docs Folder Import
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-studio-tab="interviews"
              class="studio-tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider border cursor-pointer transition-colors bg-white text-charcoal border-gray-300 hover:border-charcoal"
            >
              2. Create &amp; Edit Interviews (<span id="tab-interviews-count">{initialInterviewsData.length}</span>)
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-studio-tab="pages"
              class="studio-tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider border cursor-pointer transition-colors bg-white text-charcoal border-gray-300 hover:border-charcoal"
            >
              3. Whole-Site Text &amp; SEO
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-studio-tab="analytics"
              class="studio-tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider border cursor-pointer transition-colors bg-white text-charcoal border-gray-300 hover:border-charcoal"
            >
              4. Analytics &amp; Backups
            </button>
          </div>

          <div class="flex flex-wrap items-center justify-between lg:justify-end gap-4">
            <p id="global-studio-toast" aria-live="polite" class="text-xs sm:text-sm font-bold text-tiger-600 m-0"></p>
            <button
              type="button"
              id="sticky-studio-save-btn"
              class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-5 py-2.5 text-xs sm:text-sm uppercase tracking-wider cursor-pointer transition-colors"
            >
              <span id="sticky-studio-save-label">Save Interview Post</span> &rarr;
            </button>
          </div>
        </div>

        <!-- =========================================================
             TAB 1: IMPORT FROM GOOGLE DOCS FOLDER (AUTO-CREATE POST)
             ========================================================= -->
        <div id="studio-panel-gdrive" class="space-y-8">
          <div class="bg-white border-2 border-charcoal p-6 sm:p-10 shadow-sm space-y-6">
            <div class="border-b-2 border-charcoal pb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
              <div>
                <span class="bg-charcoal text-tiger-500 text-xs font-bold uppercase tracking-widest px-2.5 py-1">
                  Automated Post Builder
                </span>
                <h2 class="text-3xl font-black uppercase tracking-tight text-charcoal mt-2 mb-1">
                  Create Blog Post from a Google Docs Folder Link
                </h2>
                <p class="text-gray-600 text-sm m-0 max-w-3xl">
                  Paste the link to a shared Google Drive folder containing: <strong>(1)</strong> a Google Doc with the interview copy, <strong>(2)</strong> the main cover image (1200&times;628), and <strong>(3)</strong> any additional images to insert into the article. You’ll immediately be able to set the exact <strong>percentage (0%&ndash;100%)</strong> for where each image appears within the copy and edit anything before or after publishing.
                </p>
              </div>
            </div>

            <form id="gdrive-import-form" class="space-y-4">
              <div>
                <label for="gdrive-folder-url" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-2">
                  Google Drive Folder URL (or Google Doc URL) *
                </label>
                <div class="flex flex-col sm:flex-row gap-3">
                  <input
                    id="gdrive-folder-url"
                    name="folderUrl"
                    type="url"
                    required
                    placeholder="https://drive.google.com/drive/folders/1a2b3c4d5e... (ensure sharing is 'Anyone with the link')"
                    class="flex-1 px-4 py-3.5 border-2 border-charcoal bg-gray-50 text-charcoal font-mono text-sm focus:outline-none focus:border-tiger-500"
                  />
                  <button
                    type="submit"
                    id="gdrive-fetch-btn"
                    class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-black px-8 py-3.5 uppercase tracking-wider text-sm cursor-pointer transition-colors shrink-0"
                  >
                    Fetch Folder &amp; Build Post &rarr;
                  </button>
                </div>
                <p class="text-xs text-gray-500 mt-2 m-0">
                  <strong>Tip:</strong> Name your main image with the interviewee’s name or <code class="bg-gray-100 px-1">main</code>/<code class="bg-gray-100 px-1">cover</code>. Any other images in the folder are automatically added as inline article images (you can even name them e.g. <code class="bg-gray-100 px-1">photo-35%.jpg</code> or set their percentage slider after importing!).
                </p>
              </div>
            </form>

            <div id="gdrive-import-status" role="status" class="p-4 bg-gray-100 border-l-4 border-tiger-500 text-sm font-bold text-charcoal" hidden></div>

            <!-- Discovered Folder Contents Summary (shown right after fetching a Google Drive folder) -->
            <div id="gdrive-discovered-summary" hidden class="p-6 bg-gray-50 border border-gray-300 space-y-4">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <h3 class="text-xl font-black uppercase tracking-tight text-charcoal m-0">
                    Folder Imported! Review &amp; Set Image Percentages Below
                  </h3>
                  <p id="gdrive-discovered-meta" class="text-xs text-gray-600 m-0 mt-1"></p>
                </div>
                <button
                  type="button"
                  id="gdrive-open-in-editor-btn"
                  class="bg-charcoal hover:bg-tiger-600 text-offwhite font-bold px-5 py-2.5 text-xs uppercase tracking-wider cursor-pointer"
                >
                  Open in Full Interview Editor &amp; Publish &rarr;
                </button>
              </div>
            </div>

            <!-- Optional Direct Copy + Multi-Image Folder Dropper (Works even if a Google folder is private) -->
            <details class="border border-gray-300 bg-gray-50 p-4">
              <summary class="cursor-pointer text-xs font-bold uppercase tracking-wider text-charcoal">
                Or paste Google Doc copy &amp; drop folder images directly from your computer
              </summary>
              <div class="mt-4 pt-4 border-t border-gray-200 space-y-4">
                <p class="text-xs text-gray-600 m-0">
                  If your Google Doc isn’t link-shared yet, you can also paste the raw Google Doc text and select your main + inline images below to auto-build the blog post:
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="quick-build-interviewee" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      Interviewee Name (optional — auto-detected from copy)
                    </label>
                    <input
                      id="quick-build-interviewee"
                      type="text"
                      placeholder="e.g. Steph Spector"
                      class="w-full px-3 py-2 border border-gray-400 bg-white text-sm"
                    />
                  </div>
                  <div>
                    <label for="quick-build-images" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      Select Main Image + Any Inline Images
                    </label>
                    <input
                      id="quick-build-images"
                      type="file"
                      accept="image/*"
                      multiple
                      class="w-full text-xs text-charcoal file:mr-3 file:py-1.5 file:px-3 file:border file:border-charcoal file:bg-white file:text-xs file:font-bold file:cursor-pointer"
                    />
                  </div>
                </div>
                <div>
                  <label for="quick-build-copy" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                    Paste Raw Copy from Google Docs
                  </label>
                  <textarea
                    id="quick-build-copy"
                    rows="6"
                    placeholder="Paste the full interview copy here..."
                    class="w-full px-3 py-2 border border-gray-400 bg-white text-sm font-sans"
                  ></textarea>
                </div>
                <button
                  type="button"
                  id="quick-build-submit-btn"
                  class="bg-charcoal hover:bg-tiger-600 text-offwhite font-bold px-6 py-2.5 text-xs uppercase tracking-wider cursor-pointer"
                >
                  Auto-Build Post &amp; Configure Image Percentages &rarr;
                </button>
              </div>
            </details>
          </div>
        </div>

        <!-- =========================================================
             TAB 2: INTERVIEWS MANAGER & EDITOR (WITH % INLINE IMAGES)
             ========================================================= -->
        <div id="studio-panel-interviews" hidden class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Left Column: Ordered Interviews List -->
          <div class="lg:col-span-4 space-y-4">
            <div class="bg-white border-2 border-charcoal p-5 space-y-4">
              <div class="flex items-center justify-between gap-2 border-b border-gray-200 pb-3">
                <div>
                  <h2 class="text-xl font-black uppercase tracking-tight text-charcoal m-0">
                    All Interviews
                  </h2>
                  <p class="text-xs text-gray-500 m-0">
                    Click any post to edit, or use &uarr; / &darr; to reorder.
                  </p>
                </div>
                <button
                  type="button"
                  id="btn-new-interview"
                  class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-3 py-1.5 text-xs uppercase tracking-wider cursor-pointer shrink-0"
                >
                  + New Post
                </button>
              </div>

              <ul
                id="interviews-manager-list"
                role="list"
                class="space-y-3 list-none m-0 p-0"
              ></ul>
            </div>
          </div>

          <!-- Right Column: Full Interview Editor + Percentage Inline Image Placer -->
          <div class="lg:col-span-8 space-y-8">
            <div id="interview-editor-card" class="bg-white border-2 border-charcoal p-6 sm:p-8 shadow-sm space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b-2 border-charcoal">
                <div>
                  <span id="interview-editor-mode-badge" class="bg-charcoal text-tiger-500 text-xs font-bold uppercase tracking-widest px-2.5 py-0.5">
                    Editing Interview
                  </span>
                  <h2 id="interview-form-heading" class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-charcoal mt-1 m-0">
                    Edit Interview Post
                  </h2>
                </div>
                <div class="flex items-center gap-3">
                  <a
                    id="interview-view-live-link"
                    href="/interviews"
                    target="_blank"
                    class="text-xs font-bold uppercase tracking-wider text-tiger-600 hover:text-tiger-500 underline"
                  >
                    View Live Page ↗
                  </a>
                </div>
              </div>

              <form id="interview-editor-form" class="space-y-6">
                <input type="hidden" id="int-original-slug" value="" />

                <!-- Basic Metadata -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
                  <div class="sm:col-span-8">
                    <label for="int-title" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      Article Headline (H1) *
                    </label>
                    <input
                      id="int-title"
                      type="text"
                      required
                      placeholder="e.g. The Human Touch is Our Greatest Strength"
                      class="w-full px-3.5 py-2.5 border border-gray-400 bg-gray-50 text-charcoal font-bold"
                    />
                  </div>
                  <div class="sm:col-span-4">
                    <label for="int-slug" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      URL Slug *
                    </label>
                    <input
                      id="int-slug"
                      type="text"
                      required
                      placeholder="e.g. romey-norton"
                      class="w-full px-3.5 py-2.5 border border-gray-400 bg-gray-50 text-charcoal font-mono text-sm"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label for="int-interviewee" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      Interviewee Name *
                    </label>
                    <input
                      id="int-interviewee"
                      type="text"
                      required
                      placeholder="e.g. Romey Norton"
                      class="w-full px-3.5 py-2 border border-gray-400 bg-gray-50 text-charcoal"
                    />
                  </div>
                  <div>
