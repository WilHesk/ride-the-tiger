    function setByPath(obj: any, pathStr: string, value: any) {
      const parts = pathStr.split(".");
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        const p = parts[i];
        if (cur[p] === undefined || cur[p] === null) {
          cur[p] = /^\d+$/.test(parts[i + 1]) ? [] : {};
        }
        cur = cur[p];
      }
      cur[parts[parts.length - 1]] = value;
    }

