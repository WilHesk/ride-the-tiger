          : "studio-tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider border cursor-pointer transition-colors bg-white text-charcoal border-gray-300 hover:border-charcoal";
      });

      Object.entries(panels).forEach(([k, panel]) => {
        if (panel) panel.hidden = k !== target;
      });

      if (stickySaveBtn && stickySaveLabel) {
        stickySaveBtn.hidden = target === "analytics" || target === "gdrive";
        stickySaveLabel.textContent =
          target === "pages" ? "Save Page Text & SEO" : "Save Interview Post";
      }
    }

    tabBtns.forEach((btn) => {
