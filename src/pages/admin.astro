    const interviewsListEl = document.getElementById("interviews-manager-list");
    const interviewForm = document.getElementById("interview-editor-form") as HTMLFormElement | null;
    const origSlugInput = document.getElementById("int-original-slug") as HTMLInputElement | null;
    const titleInput = document.getElementById("int-title") as HTMLInputElement | null;
    const slugInput = document.getElementById("int-slug") as HTMLInputElement | null;
