    async function runGoogleDriveFolderImport(folderUrl: string) {
      if (!folderUrl) return;
      if (gdriveStatusEl) {
        gdriveStatusEl.hidden = false;
        gdriveStatusEl.textContent =
          "Connecting to Google Drive folder, reading Google Doc copy, and downloading main + inline images...";
      }
      if (gdriveFetchBtn) gdriveFetchBtn.disabled = true;

      try {
        const res = await fetch("/__cms-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "import-gdrive-folder",
            folderUrl,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok || !data.interview) {
          throw new Error(
            data.error ||
              "Could not import from Google Drive link. Please check that the folder is shared with 'Anyone with the link'."
          );
        }

        const imported = data.interview;
        const filesCount = Array.isArray(data.filesFound)
          ? data.filesFound.length
          : 1;
        const inlineCount = Array.isArray(imported.inlineImages)
          ? imported.inlineImages.length
          : 0;

        if (gdriveStatusEl) {
          gdriveStatusEl.textContent = `Successfully imported "${imported.title}" (${imported.interviewee}) — ${filesCount} file(s) processed, 1 main cover image + ${inlineCount} inline image(s)!`;
        }
        if (gdriveSummaryEl && gdriveMetaEl) {
          gdriveSummaryEl.hidden = false;
          gdriveMetaEl.textContent = `Headline: "${imported.title}" | Interviewee: ${imported.interviewee} | Read time: ${imported.readTime} | Inline images: ${inlineCount}`;
        }

        // Load into editor & switch to Tab 2 so user can review/adjust percentages and publish
        loadInterviewIntoEditor(imported, true);
        switchStudioTab("interviews");
        showToast(
          `Imported ${imported.interviewee} from Google Folder! Review image % positions and click Save & Publish.`
        );
      } catch (err: any) {
        if (gdriveStatusEl) {
          gdriveStatusEl.hidden = false;
          gdriveStatusEl.textContent =
            err?.message || "Failed to import Google Drive folder.";
        }
      } finally {
        if (gdriveFetchBtn) gdriveFetchBtn.disabled = false;
      }
    }

