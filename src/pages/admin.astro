      inlineListEl
        .querySelectorAll<HTMLButtonElement>("[data-promote-to-cover]")
        .forEach((btn) => {
          btn.addEventListener("click", () => {
            const idx = Number(btn.dataset.promoteToCover);
            const chosen = activeInlineImages[idx];
            if (!chosen) return;
            const previousCover = coverInput?.value || "";
            const previousCoverAlt = coverAltInput?.value || "";

            if (coverInput) coverInput.value = chosen.image;
            if (coverPreview) coverPreview.src = chosen.image;
            if (coverAltInput && chosen.alt) coverAltInput.value = chosen.alt;

            if (previousCover) {
              activeInlineImages[idx] = {
                image: previousCover,
                alt: previousCoverAlt || "Article inline photo",
                caption: chosen.caption || "",
                percentage: chosen.percentage,
              };
            } else {
              activeInlineImages.splice(idx, 1);
            }
            renderInlineImagesEditor();
            showToast("Swapped image into Main Hero Cover Image!");
          });
        });

      updateLiveArticlePreview();
    }

    function loadInterviewIntoEditor(item: any, isNew = false) {
      if (!item) return;
      if (origSlugInput) origSlugInput.value = isNew ? "" : item.slug || "";
      if (titleInput) titleInput.value = item.title || "";
      if (slugInput) slugInput.value = item.slug || slugify(item.interviewee || item.title || "");
      if (intervieweeInput) intervieweeInput.value = item.interviewee || "";
      if (roleInput) roleInput.value = item.role || "Copywriter";
      if (companyInput) companyInput.value = item.company || "Freelance";
      if (dateInput) {
        dateInput.value = String(item.date || new Date().toISOString()).split("T")[0];
      }
      if (readTimeInput) readTimeInput.value = item.readTime || "6 min read";
      if (tagsInput) {
        tagsInput.value = Array.isArray(item.tags)
          ? item.tags.join(", ")
          : String(item.tags || "Copywriting");
      }
      if (gdriveUrlInput) gdriveUrlInput.value = item.googleDriveFolderUrl || "";
      if (excerptInput) excerptInput.value = item.excerpt || "";
      if (quoteInput) quoteInput.value = item.quote || "";

      const resolvedCover =
        item.coverImage ||
        (item.interviewee ? `/headshots/${item.interviewee}.webp` : "/favicon.svg");
      if (coverInput) coverInput.value = resolvedCover;
      if (coverPreview) coverPreview.src = resolvedCover;
      if (coverAltInput) {
        coverAltInput.value =
          item.coverImageAlt || `Cover image for ${item.interviewee || ""}`;
      }
      if (bodyInput) bodyInput.value = item.body || "";

      activeInlineImages = Array.isArray(item.inlineImages)
        ? structuredClone(item.inlineImages)
        : [];

      if (formHeadingEl) {
        formHeadingEl.textContent = isNew
          ? `New Post: ${item.interviewee || item.title || "Untitled"}`
          : `Editing: ${item.interviewee} — ${item.title}`;
      }
      if (modeBadgeEl) {
        modeBadgeEl.textContent = isNew
          ? "New Draft (Click Save & Publish Below)"
          : "Editing Published Interview";
      }
      if (liveLinkEl) {
        liveLinkEl.href = item.slug ? `/interviews/${item.slug}` : "/interviews";
      }

      renderInlineImagesEditor();
      renderInterviewsManagerList();
    }

