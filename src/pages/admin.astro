    function updateLiveArticlePreview() {
      const bodyVal = bodyInput?.value || "";
      const words = bodyVal.trim().split(/\s+/).filter(Boolean).length;
      if (wordCountBadge) {
        wordCountBadge.textContent = `${words} words (~${Math.max(1, Math.round(words / 200))} min read)`;
      }
      if (livePreviewEl) {
        livePreviewEl.innerHTML = renderMarkdownWithInlineImages(
          bodyVal,
          activeInlineImages
        );
      }
      // Also refresh the paragraph context labels on each inline image card
      document
        .querySelectorAll<HTMLElement>("[data-inline-context-idx]")
        .forEach((el) => {
          const idx = Number(el.dataset.inlineContextIdx);
          const item = activeInlineImages[idx];
          if (item) {
            const info = getPercentageInsertionPreview(bodyVal, item.percentage);
            el.textContent = info.contextLabel;
          }
        });
    }

    function renderInlineImagesEditor() {
      if (!inlineListEl) return;
      const bodyVal = bodyInput?.value || "";

      if (activeInlineImages.length === 0) {
        inlineListEl.innerHTML = `
          <div class="p-6 bg-white border border-dashed border-gray-400 text-center text-sm text-gray-500">
            No inline images added to this article yet. Upload images above or import from a Google Docs folder to place images at any percentage (0%&ndash;100%) through the article.
          </div>
        `;
        updateLiveArticlePreview();
        return;
      }

      inlineListEl.innerHTML = activeInlineImages
        .map((item, idx) => {
          const pct = Math.max(0, Math.min(100, Math.round(Number(item.percentage) ?? 50)));
          const previewInfo = getPercentageInsertionPreview(bodyVal, pct);
          return `
            <div class="p-4 bg-white border-2 border-charcoal space-y-3" data-inline-card="${idx}">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-200 pb-2">
                <div class="flex items-center gap-2">
                  <span class="bg-tiger-500 text-charcoal text-xs font-black uppercase px-2 py-0.5">
                    Inline Image #${idx + 1}
                  </span>
                  <span class="text-xs font-bold text-charcoal">
                    Appears at <strong class="text-tiger-600" data-inline-pct-badge="${idx}">${pct}%</strong> of article
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    data-promote-to-cover="${idx}"
                    class="text-xs font-bold text-charcoal hover:text-tiger-600 border border-gray-300 px-2.5 py-1 cursor-pointer bg-gray-50"
                    title="Swap this inline image with the Main Hero Cover Image"
                  >
                    Make Main Cover Image
                  </button>
                  <button
                    type="button"
                    data-remove-inline="${idx}"
                    class="text-xs font-bold text-red-700 hover:bg-red-50 border border-red-200 px-2.5 py-1 cursor-pointer bg-white"
                  >
                    Remove
                  </button>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
                <div class="md:col-span-4">
                  <div class="aspect-[16/10] bg-gray-200 border border-gray-300 overflow-hidden">
                    <img
                      src="${escapeHtml(item.image)}"
                      alt="${escapeHtml(item.alt || "Inline preview")}"
                      class="w-full h-full object-cover"
                    />
                  </div>
                </div>

                <div class="md:col-span-8 space-y-3">
                  <!-- PERCENTAGE CONTROL (SLIDER + NUMBER INPUT) -->
                  <div class="p-3 bg-gray-50 border border-gray-300 space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <label class="text-xs font-black uppercase tracking-wider text-charcoal">
                        Position in Article (%) — 0% (Start) to 100% (End)
                      </label>
                      <div class="flex items-center gap-1">
                        <input
                          type="number"
                          min="0"
                          max="100"
                          step="1"
                          value="${pct}"
                          data-inline-pct-num="${idx}"
                          aria-label="Position percentage in article"
                          class="w-20 px-2.5 py-1 border-2 border-charcoal bg-white text-charcoal font-black text-sm text-center"
                        />
                        <span class="text-sm font-black text-charcoal">%</span>
                      </div>
                    </div>

                    <input
                      type="range"
                      min="0"
                      max="100"
                      step="1"
                      value="${pct}"
                      data-inline-pct-range="${idx}"
                      aria-label="Slide to adjust percentage position in article"
                      class="w-full accent-[var(--color-tiger-500)] cursor-pointer"
                    />

                    <p
                      data-inline-context-idx="${idx}"
                      class="text-xs text-gray-700 font-medium m-0 bg-white p-2 border-l-4 border-tiger-500"
                    >
                      ${escapeHtml(previewInfo.contextLabel)}
                    </p>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                        Image URL / Uploaded Path
                      </label>
                      <input
                        type="text"
                        value="${escapeHtml(item.image)}"
                        data-inline-field="image"
                        data-inline-idx="${idx}"
                        class="w-full px-2.5 py-1.5 border border-gray-400 bg-white text-xs font-mono"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                        Alt Text
                      </label>
                      <input
                        type="text"
                        value="${escapeHtml(item.alt || "")}"
                        data-inline-field="alt"
                        data-inline-idx="${idx}"
                        placeholder="Describe the photo..."
                        class="w-full px-2.5 py-1.5 border border-gray-400 bg-white text-xs"
                      />
                    </div>
                  </div>

                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1">
                      Optional Caption (displayed beneath image in article)
                    </label>
                    <input
                      type="text"
                      value="${escapeHtml(item.caption || "")}"
                      data-inline-field="caption"
                      data-inline-idx="${idx}"
                      placeholder="Optional caption..."
                      class="w-full px-2.5 py-1.5 border border-gray-400 bg-white text-xs"
                    />
                  </div>
                </div>
              </div>
            </div>
          `;
        })
        .join("");

      // Wire events for percentage sliders, number inputs, fields, remove, and swap-with-cover
      inlineListEl
        .querySelectorAll<HTMLInputElement>("[data-inline-pct-range]")
        .forEach((rangeInput) => {
          rangeInput.addEventListener("input", () => {
            const idx = Number(rangeInput.dataset.inlinePctRange);
            const val = Math.max(0, Math.min(100, Number(rangeInput.value) || 0));
            activeInlineImages[idx].percentage = val;
            const numEl = inlineListEl.querySelector<HTMLInputElement>(
              `[data-inline-pct-num="${idx}"]`
            );
            if (numEl) numEl.value = String(val);
            const badgeEl = inlineListEl.querySelector<HTMLElement>(
              `[data-inline-pct-badge="${idx}"]`
            );
            if (badgeEl) badgeEl.textContent = `${val}%`;
            updateLiveArticlePreview();
          });
        });

      inlineListEl
        .querySelectorAll<HTMLInputElement>("[data-inline-pct-num]")
        .forEach((numInput) => {
          numInput.addEventListener("input", () => {
            const idx = Number(numInput.dataset.inlinePctNum);
            const val = Math.max(0, Math.min(100, Number(numInput.value) || 0));
            activeInlineImages[idx].percentage = val;
            const rangeEl = inlineListEl.querySelector<HTMLInputElement>(
              `[data-inline-pct-range="${idx}"]`
            );
            if (rangeEl) rangeEl.value = String(val);
            const badgeEl = inlineListEl.querySelector<HTMLElement>(
              `[data-inline-pct-badge="${idx}"]`
            );
            if (badgeEl) badgeEl.textContent = `${val}%`;
            updateLiveArticlePreview();
          });
        });

      inlineListEl
        .querySelectorAll<HTMLInputElement>("[data-inline-field]")
        .forEach((input) => {
          input.addEventListener("input", () => {
            const idx = Number(input.dataset.inlineIdx);
            const field = input.dataset.inlineField as "image" | "alt" | "caption";
            if (activeInlineImages[idx] && field) {
              (activeInlineImages[idx] as any)[field] = input.value;
              updateLiveArticlePreview();
            }
          });
        });

      inlineListEl
        .querySelectorAll<HTMLButtonElement>("[data-remove-inline]")
        .forEach((btn) => {
          btn.addEventListener("click", () => {
            const idx = Number(btn.dataset.removeInline);
