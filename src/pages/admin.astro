        if (!cloud || !cloud.ok) return;

        if (cloud.analytics) {
          const pvEl = document.getElementById("analytics-stat-pageviews");
          if (pvEl) pvEl.textContent = String(cloud.analytics.pageviews || 0);
          const topPagesContainer = document.getElementById("analytics-top-pages-container");
          const counts = cloud.analytics.pageCounts || {};
          const entries = Object.entries(counts).sort(
            (a: any, b: any) => Number(b[1]) - Number(a[1])
          );
          if (topPagesContainer && entries.length > 0) {
            topPagesContainer.innerHTML = entries
              .slice(0, 8)
              .map(
                ([pg, cnt]) =>
                  `<div class="flex justify-between py-1.5 border-b border-gray-100"><span class="font-mono">${escapeHtml(pg)}</span><strong>${cnt} views</strong></div>`
              )
              .join("");
          }
        }

        const hasLocalInterviews = Boolean(localStorage.getItem(INTERVIEWS_STORAGE_KEY));
        if (Array.isArray(cloud.interviews) && cloud.interviews.length > 0) {
          interviewsList = cloud.interviews;
          localStorage.setItem(INTERVIEWS_STORAGE_KEY, JSON.stringify(interviewsList));
          renderInterviewsManagerList();
          const currentSlug = origSlugInput?.value;
          const active = interviewsList.find((i) => i.slug === currentSlug) || interviewsList[0];
          if (active) loadInterviewIntoEditor(active, false);
        } else if (hasLocalInterviews) {
          fetch("/__cms-sync", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "sync-interviews", items: interviewsList }),
          }).catch(() => {});
        }

        if (cloud.siteContent && typeof cloud.siteContent === "object") {
          currentSiteContent = cloud.siteContent;
          localStorage.setItem(SITE_CONTENT_KEY, JSON.stringify(currentSiteContent));
          renderActivePageFields();
        }
      })
      .catch(() => {});
  }

  initRttAdminStudio();
  document.addEventListener("astro:page-load", initRttAdminStudio);
</script>
