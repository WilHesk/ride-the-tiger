<script>
  import {
    renderMarkdownWithInlineImages,
    getPercentageInsertionPreview,
    escapeHtml,
    type InlineImageItem,
  } from "../utils/articleRenderer";

  function initRttAdminStudio() {
    const seedEl = document.getElementById("initial-rtt-cms-seed");
    if (!seedEl) return;

    const seedData = JSON.parse(seedEl.textContent || "{}");
    const INTERVIEWS_STORAGE_KEY = "rtt_cms_interviews_v1";
    const SITE_CONTENT_KEY = "rtt_cms_site_content_v1";
    const ACCOUNTS_STORAGE_KEY = "rtt_studio_accounts_v1";
    const AUTH_KEY = "rtt_studio_auth_v1";
    const OWNER_EMAIL = "wilhesk@gmail.com";
    const OWNER_NAME = "Wil Hesketh";

    const globalToast = document.getElementById("global-studio-toast");
    function showToast(msg: string) {
      if (globalToast) globalToast.textContent = msg;
    }

    function slugify(text: string): string {
      return String(text || "")
        .toLowerCase()
        .trim()
        .replace(/['’]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function loadInterviewsList(): any[] {
      try {
        const raw = localStorage.getItem(INTERVIEWS_STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed;
          }
        }
      } catch {
        // ignore
      }
      return structuredClone(seedData.interviews || []);
    }

    function loadSiteContent(): any {
      try {
        const raw = localStorage.getItem(SITE_CONTENT_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed === "object") {
            return parsed;
          }
        }
      } catch {
        // ignore
      }
      return structuredClone(seedData.siteContent || {});
    }

    let interviewsList: any[] = loadInterviewsList();
    let currentSiteContent: any = loadSiteContent();
    let activeInlineImages: InlineImageItem[] = [];

    async function uploadFileToServer(file: File): Promise<string> {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ""));
        reader.onerror = () => reject(new Error("File read error"));
        reader.readAsDataURL(file);
      });

      try {
        const res = await fetch("/__cms-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "upload-image",
            filename: file.name,
            dataUrl,
          }),
        });
        if (res.ok) {
          const json = await res.json();
          if (json.ok && json.url) {
            return json.url;
          }
        }
      } catch {
        // fallback to dataUrl
      }
      return dataUrl;
    }

    async function persistInterviewsList(list: any[], toastMessage?: string) {
      interviewsList = list.map((item, idx) => ({
        ...item,
        order: idx + 1,
      }));
      localStorage.setItem(
        INTERVIEWS_STORAGE_KEY,
        JSON.stringify(interviewsList)
      );

      const countEl = document.getElementById("tab-interviews-count");
      if (countEl) countEl.textContent = String(interviewsList.length);
      const statEl = document.getElementById("analytics-stat-interviews");
      if (statEl) statEl.textContent = String(interviewsList.length);

      try {
        await fetch("/__cms-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "sync-interviews",
            items: interviewsList,
          }),
        });
      } catch {
        // local storage fallback remains active
      }

      renderInterviewsManagerList();
      if (toastMessage) showToast(toastMessage);
    }

    // =====================================================
    // AUTHENTICATION LOGIC (Netlify + Password Manager)
    // =====================================================
    const loginPanel = document.getElementById("admin-login-panel");
    const workspace = document.getElementById("admin-studio-workspace");
    const logoutBtn = document.getElementById("admin-logout-btn");
    const viewSignin = document.getElementById("auth-view-signin");
    const viewSignup = document.getElementById("auth-view-signup");
    const loginForm = document.getElementById("admin-login-form") as HTMLFormElement | null;
    const signupForm = document.getElementById("admin-signup-form") as HTMLFormElement | null;
    const loginErrorMsg = document.getElementById("login-error-msg");
    const signupErrorMsg = document.getElementById("signup-error-msg");
    const netlifyPatDrawer = document.getElementById("netlify-pat-drawer");
    const netlifyAuthStatus = document.getElementById("netlify-auth-status");
    const netlifyTokenForm = document.getElementById("netlify-token-form") as HTMLFormElement | null;

    function bytesToHex(bytes: Uint8Array): string {
      return Array.from(bytes)
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    }

    function generateSaltHex(byteLen = 16): string {
      const arr = new Uint8Array(byteLen);
      crypto.getRandomValues(arr);
      return bytesToHex(arr);
    }

    async function sha256Hex(input: string): Promise<string> {
      const encoded = new TextEncoder().encode(input);
      const digest = await crypto.subtle.digest("SHA-256", encoded);
      return bytesToHex(new Uint8Array(digest));
    }

    async function hashPasswordWithSalt(password: string, salt: string): Promise<string> {
      return sha256Hex(`${salt}:${password}:ride-the-tiger-v1`);
    }

    function loadAdminAccounts(): any[] {
      try {
        const raw = localStorage.getItem(ACCOUNTS_STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) return parsed;
        }
      } catch {
        // ignore
      }
      return Array.isArray(seedData.adminAccounts) ? seedData.adminAccounts : [];
    }

    async function saveAdminAccounts(accounts: any[]) {
      localStorage.setItem(ACCOUNTS_STORAGE_KEY, JSON.stringify(accounts));
      try {
        await fetch("/__cms-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "sync-admin-accounts",
            accounts,
          }),
        });
      } catch {
        // ignore
      }
    }

    function getAuthUser(): { name: string; email: string } | null {
      try {
        const raw = sessionStorage.getItem(AUTH_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    function completeSignInSession(email: string, name: string) {
      sessionStorage.setItem(
        AUTH_KEY,
        JSON.stringify({
          name: name || OWNER_NAME,
          email: email.toLowerCase().trim(),
          time: Date.now(),
        })
      );
      updateAuthUI();
    }

    function updateAuthUI() {
      const user = getAuthUser();
      if (user && loginPanel && workspace && logoutBtn) {
        loginPanel.hidden = true;
        workspace.hidden = false;
        logoutBtn.hidden = false;
      } else if (loginPanel && workspace && logoutBtn) {
        loginPanel.hidden = false;
        workspace.hidden = true;
        logoutBtn.hidden = true;
      }
    }

    document.getElementById("toggle-login-password")?.addEventListener("click", (e) => {
      const input = document.getElementById("current-password") as HTMLInputElement | null;
      const btn = e.currentTarget as HTMLButtonElement;
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.textContent = show ? "Hide password" : "Show password";
    });

    document.getElementById("toggle-signup-password")?.addEventListener("click", (e) => {
      const input = document.getElementById("new-password") as HTMLInputElement | null;
      const btn = e.currentTarget as HTMLButtonElement;
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.textContent = show ? "Hide password" : "Show password";
    });

    document.getElementById("open-signup-view-btn")?.addEventListener("click", () => {
      if (viewSignin) viewSignin.hidden = true;
      if (viewSignup) viewSignup.hidden = false;
    });
    document.getElementById("open-forgot-password-btn")?.addEventListener("click", () => {
      if (viewSignin) viewSignin.hidden = true;
      if (viewSignup) viewSignup.hidden = false;
    });
    document.getElementById("back-to-signin-btn")?.addEventListener("click", () => {
      if (viewSignin) viewSignin.hidden = false;
      if (viewSignup) viewSignup.hidden = true;
    });

    document.getElementById("netlify-login-btn")?.addEventListener("click", async () => {
      let identityEnabled = false;
      try {
        const res = await fetch("/.netlify/identity/settings");
        identityEnabled = res.ok;
      } catch {
        identityEnabled = false;
      }
      if (identityEnabled && (window as any).netlifyIdentity) {
        (window as any).netlifyIdentity.open("login");
        return;
      }
      if (netlifyPatDrawer) netlifyPatDrawer.hidden = false;
      if (netlifyAuthStatus) {
        netlifyAuthStatus.textContent = "Paste your Netlify Personal Access Token below to verify your account.";
      }
    });

    netlifyTokenForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = document.getElementById("netlify-pat-input") as HTMLInputElement | null;
      const token = String(input?.value || "").trim();
      if (!token) return;
      try {
        const res = await fetch("https://api.netlify.com/api/v1/user", {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) {
          if (netlifyAuthStatus) netlifyAuthStatus.textContent = "Invalid Netlify token.";
          return;
        }
        const netlifyUser = await res.json();
        completeSignInSession(netlifyUser.email || OWNER_EMAIL, netlifyUser.full_name || OWNER_NAME);
      } catch {
        if (netlifyAuthStatus) netlifyAuthStatus.textContent = "Could not verify with api.netlify.com.";
      }
    });

    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (loginErrorMsg) loginErrorMsg.textContent = "";
      const data = new FormData(loginForm);
      const email = String(data.get("email") || "").trim().toLowerCase();
      const password = String(data.get("password") || "");

      if (email !== OWNER_EMAIL) {
        if (loginErrorMsg) loginErrorMsg.textContent = `Access restricted to ${OWNER_EMAIL}.`;
        return;
      }

      const accounts = loadAdminAccounts();
      let account = accounts.find((a) => String(a.email || "").toLowerCase() === OWNER_EMAIL);

      if (!account || !account.passwordHash) {
        if (password.length < 8) {
          if (loginErrorMsg) loginErrorMsg.textContent = "Please choose a password of at least 8 characters.";
          return;
        }
        const salt = generateSaltHex(16);
        const passwordHash = await hashPasswordWithSalt(password, salt);
        account = {
          email: OWNER_EMAIL,
          name: OWNER_NAME,
          passwordHash,
          salt,
          verified: true,
          updatedAt: new Date().toISOString(),
        };
        await saveAdminAccounts([account]);
        completeSignInSession(OWNER_EMAIL, OWNER_NAME);
        return;
      }

      const candidateHash = await hashPasswordWithSalt(password, account.salt);
      if (candidateHash !== account.passwordHash) {
        if (loginErrorMsg) {
          loginErrorMsg.textContent = "Incorrect password. Click 'Set / Reset password' to update.";
        }
        return;
      }
      completeSignInSession(OWNER_EMAIL, OWNER_NAME);
    });

    signupForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (signupErrorMsg) signupErrorMsg.textContent = "";
      const data = new FormData(signupForm);
      const newPassword = String(data.get("new-password") || "");
      if (newPassword.length < 8) {
        if (signupErrorMsg) signupErrorMsg.textContent = "Password must be at least 8 characters.";
        return;
      }
      const salt = generateSaltHex(16);
      const passwordHash = await hashPasswordWithSalt(newPassword, salt);
      await saveAdminAccounts([
        {
          email: OWNER_EMAIL,
          name: OWNER_NAME,
          passwordHash,
          salt,
          verified: true,
          updatedAt: new Date().toISOString(),
        },
      ]);
      completeSignInSession(OWNER_EMAIL, OWNER_NAME);
    });

