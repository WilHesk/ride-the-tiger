---
import Layout from '../layouts/Layout.astro';
import siteContent from '../data/site-content.json';

const about = siteContent.about || {};
const whoItems = Array.isArray(about.whoItems) ? about.whoItems : [];
const whyItems = Array.isArray(about.whyItems) ? about.whyItems : [];
---

<Layout title={siteContent.seo?.aboutTitle || "About | Ride The Tiger"}>
  <div class="container mx-auto px-6 max-w-3xl py-20">
    <header class="mb-16 border-b-4 border-tiger-500 pb-8 inline-block">
      <h1
        data-cms-text="about.heading"
        class="text-5xl font-bold tracking-tight mb-4 font-sans uppercase"
      >
        {about.heading || "About Ride The Tiger"}
      </h1>
      <p
        data-cms-text="about.subheading"
        class="text-2xl text-gray-500 font-serif italic"
      >
        {about.subheading || "Unvarnished peer reality for the AI creative transition."}
      </p>
    </header>

    <article class="prose prose-lg prose-neutral max-w-none">
      <h2
        data-cms-text="about.introHeading"
        class="text-3xl font-bold uppercase tracking-tight mt-12 mb-6"
      >
        {about.introHeading || "What is Ride The Tiger?"}
      </h2>
      <p data-cms-text="about.introPara1" class="leading-relaxed">
        {about.introPara1 || "Ride The Tiger is an independent interview publication documenting how artificial intelligence is reshaping the creative landscape. Through long-form, peer-to-peer dialogues with agency directors, independent copywriters, art directors, and creative strategists, we capture the ground truth of working with—and against—emerging generative tools."}
      </p>
      <p data-cms-text="about.introPara2" class="leading-relaxed">
        {about.introPara2 || "The name comes from the ancient paradox: once you are on the tiger’s back, you cannot simply jump off without getting mauled. AI isn’t going away, but blindly worshipping it is equally foolish. You have to learn to steer it."}
      </p>

      <h2
        data-cms-text="about.whoHeading"
        class="text-3xl font-bold uppercase tracking-tight mt-12 mb-6"
      >
        {about.whoHeading || "Who It’s For"}
      </h2>
      <ul data-cms-list="about.whoItems" class="space-y-4">
        {whoItems.map((item) => (
          <li>
            <strong>{item.bold}</strong> {item.text}
          </li>
        ))}
      </ul>

      <h2
        data-cms-text="about.whyHeading"
        class="text-3xl font-bold uppercase tracking-tight mt-12 mb-6"
      >
        {about.whyHeading || "Why You Should Read It"}
      </h2>
      <ul data-cms-list="about.whyItems" class="space-y-4 mb-12">
        {whyItems.map((item) => (
          <li>
            <strong>{item.bold}</strong> {item.text}
          </li>
        ))}
      </ul>

      <div class="not-prose mt-12">
        <a
          href="/interviews"
          data-cms-text="about.ctaLabel"
          class="inline-block bg-tiger-500 hover:bg-tiger-600 text-[var(--color-charcoal)] font-bold px-10 py-5 uppercase tracking-wider transition-colors shadow-lg"
        >
          {about.ctaLabel || "Read the Interviews"}
        </a>
      </div>
    </article>
  </div>
</Layout>
