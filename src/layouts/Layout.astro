---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  keywords?: string[];
  publishedTime?: Date;
}

const { 
  title = "Ride The Tiger", 
  description = "An Editorial Series on Creative Survival",
  image = "/favicon.svg",
  type = "website",
  keywords = ["creativity", "AI", "copywriting", "design", "agencies"],
  publishedTime
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const siteName = "Ride The Tiger";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url.origin)} />
    <meta property="og:site_name" content={siteName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url.origin)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-offwhite)]/80 border-b border-gray-200 py-6">
      <div class="container mx-auto px-6 max-w-5xl flex justify-between items-center">
        <a href="/" class="text-2xl font-bold tracking-tighter uppercase">Ride The Tiger</a>
        <nav class="space-x-6 text-sm font-medium tracking-wide uppercase">
          <a href="/interviews" class="hover:text-tiger-600 transition-colors">Interviews</a>
          <a href="/about" class="hover:text-tiger-600 transition-colors">About</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-charcoal text-offwhite py-16 mt-24 border-t-4 border-tiger-500">
      <div class="container mx-auto px-6 max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-3xl font-bold mb-4 font-serif">Stay on top of the shift.</h3>
          <p class="text-gray-400 max-w-md mb-8 leading-relaxed">
            New peer interviews, candid teardowns, and creative survival strategies delivered straight to your inbox every fortnight.
          </p>
          <div class="flex gap-2">
            <input type="email" placeholder="Your email address" class="bg-gray-800 text-white px-4 py-3 w-full max-w-xs focus:outline-none focus:ring-2 focus:ring-tiger-500 rounded-none border border-gray-700" />
            <button class="bg-tiger-500 hover:bg-tiger-600 text-charcoal font-bold px-6 py-3 transition-colors uppercase tracking-wider text-sm rounded-none">Subscribe</button>
          </div>
        </div>
        <div class="md:text-right flex flex-col justify-end">
          <p class="text-gray-400 italic font-serif text-lg">Ride The Tiger. Documenting human creativity in the age of algorithms.</p>
          <p class="text-gray-600 text-sm mt-4 uppercase tracking-widest">&copy; {new Date().getFullYear()} Ride The Tiger</p>
        </div>
      </div>
    </footer>
  </body>
</html>
